---
import Base from '../layouts/Base.astro';
import EventCard from '../components/EventCard.astro';
import { supabase } from '../lib/supabase';

const now = new Date().toISOString();

const { data: proximoEvento } = await supabase
  .from('eventos')
  .select('*')
  .eq('publicado', true)
  .gte('fecha_inicio', now)
  .order('fecha_inicio', { ascending: true })
  .limit(1)
  .single();

const { data: colaboradores } = await supabase
  .from('colaboradores')
  .select('id, nombre, logo_ruta, web_url')
  .eq('activo', true)
  .order('orden', { ascending: true });

const { count: totalEventos } = await supabase
  .from('eventos')
  .select('*', { count: 'exact', head: true })
  .eq('publicado', true);

const { count: totalAlbumes } = await supabase
  .from('albumes')
  .select('*', { count: 'exact', head: true })
  .eq('publicado', true);

const totalColaboradores = colaboradores?.length || 0;

const bucketUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/logos`;
---

<Base title="Inicio" description="AMPA Los Lirios — Asociación de Madres y Padres de Alumnos del CEIP Andalucía en Camas, Sevilla. Fiestas, actividades, galería de fotos y comercios colaboradores.">

  <!-- HERO -->
  <section class="relative overflow-hidden bg-gradient-to-br from-verde-50 via-white to-malva-50 animated-gradient">
    <!-- Decorative blobs -->
    <div class="absolute top-10 -left-20 w-72 h-72 bg-verde-200/30 rounded-full blur-3xl float-animation"></div>
    <div class="absolute bottom-10 -right-20 w-80 h-80 bg-malva-200/30 rounded-full blur-3xl float-animation-delayed"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-verde-100/20 rounded-full blur-3xl"></div>

    <div class="relative max-w-5xl mx-auto px-4 py-20 md:py-32 text-center">
      <div class="reveal">
        <div class="inline-flex items-center gap-2 bg-white/80 backdrop-blur-sm border border-verde-200 text-verde-700 text-sm font-medium px-4 py-1.5 rounded-full mb-6 shadow-sm">
          <span class="w-2 h-2 bg-verde-500 rounded-full animate-pulse"></span>
          Asociación de Madres y Padres de Alumnos
        </div>
      </div>

      <h1 class="text-5xl md:text-7xl font-extrabold text-gray-900 mb-6 tracking-tight reveal" style="transition-delay: 100ms">
        AMPA
        <span class="bg-gradient-to-r from-verde-500 to-verde-600 bg-clip-text text-transparent"> Los Lirios</span>
      </h1>

      <p class="text-lg md:text-xl text-gray-600 max-w-2xl mx-auto leading-relaxed reveal" style="transition-delay: 200ms">
        Trabajamos juntos por una comunidad educativa mejor para nuestros hijos e hijas.
        Fiestas, actividades y mucho más.
      </p>

      <div class="mt-10 flex flex-wrap justify-center gap-4 reveal" style="transition-delay: 300ms">
        <a href="/fiestas" class="btn-primary text-base px-8 py-3.5">
          <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
          </svg>
          Próximas fiestas
        </a>
        <a href="/contacto" class="btn-outline text-base px-8 py-3.5">
          Hazte socio/a
        </a>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="relative -mt-8 z-10">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-white rounded-3xl shadow-xl border border-gray-100 p-6 md:p-8 reveal-scale">
        <div class="grid grid-cols-3 gap-4 md:gap-8 text-center">
          <div>
            <div class="text-3xl md:text-4xl font-extrabold text-verde-600 counter" data-target={totalEventos || 0}>
              {totalEventos || 0}
            </div>
            <div class="text-xs md:text-sm text-gray-500 mt-1 font-medium">Eventos organizados</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-extrabold text-malva-600 counter" data-target={totalAlbumes || 0}>
              {totalAlbumes || 0}
            </div>
            <div class="text-xs md:text-sm text-gray-500 mt-1 font-medium">Álbumes de fotos</div>
          </div>
          <div>
            <div class="text-3xl md:text-4xl font-extrabold text-verde-600 counter" data-target={totalColaboradores}>
              {totalColaboradores}
            </div>
            <div class="text-xs md:text-sm text-gray-500 mt-1 font-medium">Colaboradores</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PRÓXIMO EVENTO -->
  {proximoEvento && (
    <section class="max-w-4xl mx-auto px-4 py-16 md:py-20">
      <div class="text-center mb-8 reveal">
        <span class="inline-block bg-verde-100 text-verde-700 text-xs font-bold uppercase tracking-widest px-3 py-1 rounded-full mb-3">
          No te lo pierdas
        </span>
        <h2 class="section-title">Próximo evento</h2>
      </div>
      <div class="max-w-xl mx-auto reveal" style="transition-delay: 150ms">
        <EventCard {...proximoEvento} destacado />
      </div>
      <div class="text-center mt-8 reveal" style="transition-delay: 250ms">
        <a href="/fiestas" class="text-verde-600 hover:text-verde-700 font-semibold text-sm inline-flex items-center gap-1 group">
          Ver todos los eventos
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>
  )}

  <!-- QUÉ HACEMOS -->
  <section class="bg-gray-50 py-16 md:py-20">
    <div class="max-w-5xl mx-auto px-4">
      <div class="text-center mb-12 reveal">
        <h2 class="section-title">¿Qué hacemos?</h2>
        <p class="section-subtitle">Estamos para las familias, siempre</p>
      </div>
      <div class="grid md:grid-cols-3 gap-6 stagger-children">
        <div class="card card-hover p-8 text-center">
          <div class="w-16 h-16 bg-verde-100 rounded-2xl flex items-center justify-center mx-auto mb-5 text-3xl
                      group-hover:scale-110 transition-transform duration-300">
            🎉
          </div>
          <h3 class="font-bold text-gray-900 mb-2 text-lg">Fiestas y eventos</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Organizamos fiestas, excursiones y actividades para toda la comunidad educativa.</p>
        </div>
        <div class="card card-hover p-8 text-center">
          <div class="w-16 h-16 bg-malva-100 rounded-2xl flex items-center justify-center mx-auto mb-5 text-3xl">
            🤝
          </div>
          <h3 class="font-bold text-gray-900 mb-2 text-lg">Colaboradores</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Acuerdos con comercios locales que ofrecen ventajas exclusivas a las familias socias.</p>
        </div>
        <div class="card card-hover p-8 text-center">
          <div class="w-16 h-16 bg-verde-100 rounded-2xl flex items-center justify-center mx-auto mb-5 text-3xl">
            💬
          </div>
          <h3 class="font-bold text-gray-900 mb-2 text-lg">Representación</h3>
          <p class="text-gray-500 text-sm leading-relaxed">Somos la voz de las familias ante el colegio y la administración educativa.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA - Hazte socio -->
  <section class="py-16 md:py-20 reveal">
    <div class="max-w-4xl mx-auto px-4">
      <div class="bg-gradient-to-br from-verde-500 to-verde-600 rounded-3xl p-8 md:p-12 text-center text-white relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-white/10 rounded-full -translate-y-1/2 translate-x-1/2 blur-2xl"></div>
        <div class="absolute bottom-0 left-0 w-48 h-48 bg-white/10 rounded-full translate-y-1/2 -translate-x-1/2 blur-2xl"></div>
        <div class="relative">
          <h2 class="text-3xl md:text-4xl font-extrabold mb-4">¿Quieres formar parte?</h2>
          <p class="text-verde-100 text-lg mb-8 max-w-lg mx-auto">
            Hazte socio/a del AMPA y disfruta de ventajas en comercios colaboradores, acceso a actividades y mucho más.
          </p>
          <a href="/contacto" class="inline-flex items-center justify-center px-8 py-3.5 bg-white text-verde-700 font-bold rounded-xl
                                     hover:bg-verde-50 transition-all duration-300 hover:shadow-lg hover:-translate-y-0.5 text-base">
            Más información
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- COLABORADORES MARQUEE -->
  {colaboradores && colaboradores.length > 0 && (
    <section class="py-16 bg-gray-50 overflow-hidden">
      <div class="max-w-5xl mx-auto px-4 text-center mb-10 reveal">
        <h2 class="section-title">Nuestros colaboradores</h2>
        <p class="section-subtitle">Comercios que apoyan a las familias del AMPA</p>
      </div>

      <!-- Marquee -->
      <div class="relative" aria-label="Logos de colaboradores">
        <div class="absolute left-0 top-0 bottom-0 w-20 bg-gradient-to-r from-gray-50 to-transparent z-10"></div>
        <div class="absolute right-0 top-0 bottom-0 w-20 bg-gradient-to-l from-gray-50 to-transparent z-10"></div>
        <div class="overflow-hidden">
          <div class="marquee-track">
            {/* Duplicated for seamless loop */}
            {[...colaboradores, ...colaboradores].map((c) => (
              <a
                href={c.web_url}
                target="_blank"
                rel="noopener noreferrer"
                class="flex-shrink-0 mx-8 flex items-center justify-center h-16 w-32
                       grayscale hover:grayscale-0 opacity-50 hover:opacity-100 transition-all duration-500"
                title={c.nombre}
              >
                {c.logo_ruta ? (
                  <img src={`${bucketUrl}/${c.logo_ruta}`} alt={`Logo de ${c.nombre}`}
                       class="h-12 w-auto max-w-[120px] object-contain" loading="lazy" />
                ) : (
                  <span class="text-sm font-bold text-gray-400 whitespace-nowrap">{c.nombre}</span>
                )}
              </a>
            ))}
          </div>
        </div>
      </div>

      <div class="text-center mt-8">
        <a href="/colaboradores" class="text-verde-600 hover:text-verde-700 font-semibold text-sm inline-flex items-center gap-1 group">
          Ver todos los colaboradores
          <svg class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </section>
  )}
</Base>
