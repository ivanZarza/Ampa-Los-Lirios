---
import Base from '../layouts/Base.astro';
import PhotoGrid from '../components/PhotoGrid.astro';
import { supabase } from '../lib/supabase';

const { data: albumes } = await supabase
  .from('albumes')
  .select(`
    id,
    titulo,
    fecha,
    fotos (id, ruta_storage, pie, orden)
  `)
  .eq('publicado', true)
  .order('fecha', { ascending: false });

const bucketUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/fotos`;
---

<Base title="Galería de fotos" description="Galería de fotos de las actividades del AMPA Los Lirios.">
  <section class="max-w-5xl mx-auto px-4 py-12">
    <h1 class="text-3xl font-bold text-gray-900 mb-2">Galería de fotos</h1>
    <p class="text-gray-500 mb-8">Recuerdos de nuestras actividades y fiestas</p>

    {albumes && albumes.length > 0 ? (
      <div class="space-y-12">
        {albumes.map((album) => (
          <div>
            <div class="flex items-baseline gap-3 mb-4">
              <h2 class="text-xl font-bold text-gray-900">{album.titulo}</h2>
              {album.fecha && (
                <span class="text-sm text-gray-400">
                  {new Date(album.fecha).toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}
                </span>
              )}
            </div>
            <PhotoGrid
              fotos={(album.fotos || []).sort((a: any, b: any) => a.orden - b.orden)}
              bucketUrl={bucketUrl}
            />
          </div>
        ))}
      </div>
    ) : (
      <div class="bg-gray-50 rounded-xl p-12 text-center">
        <div class="text-4xl mb-3">📸</div>
        <p class="text-gray-500">Aún no hay fotos. ¡Pronto subiremos las primeras!</p>
      </div>
    )}
  </section>
</Base>
