---
export const prerender = true;

import Base from '../layouts/Base.astro';
---

<Base title="Página no encontrada" description="La página que buscas no existe. Vuelve a la web del AMPA Los Lirios.">
  <section class="max-w-2xl mx-auto px-4 py-20 md:py-32 text-center">
    <div class="text-8xl mb-6">🌿</div>
    <h1 class="text-4xl md:text-5xl font-extrabold text-gray-900 mb-4">
      Página no encontrada
    </h1>
    <p class="text-lg text-gray-500 mb-8">
      Parece que esta página no existe o se ha movido. Pero no te preocupes, puedes volver al inicio.
    </p>
    <a href="/" class="btn-primary text-base px-8 py-3.5">
      Volver al inicio
    </a>
  </section>
</Base>
