---
export const prerender = false;
import Admin from '../../layouts/Admin.astro';
import { requireAdmin, getRoutesForUser } from '../../lib/auth';

const session = await requireAdmin(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const rutasUsuario = await getRoutesForUser(session.user.email!);
const sinPermiso = Astro.url.searchParams.has('sin_permiso');
---

<Admin title="Panel de administración">
  {sinPermiso && (
    <div class="bg-red-50 border border-red-200 text-red-700 rounded-lg px-4 py-3 mb-4 text-sm">
      No tienes permiso para acceder a esa sección.
    </div>
  )}

  <h1 class="text-2xl font-bold text-gray-900 mb-2">Panel de administración</h1>
  <p class="text-gray-500 mb-8">Bienvenido/a, {session.user.email}</p>

  <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4">
    {rutasUsuario.map((r: any) => (
      <a href={r.ruta} class="card p-6 hover:shadow-lg transition-shadow group">
        <div class="text-3xl mb-3">{r.icono}</div>
        <h2 class="text-lg font-bold text-gray-900 group-hover:text-verde-600 transition-colors">{r.nombre}</h2>
      </a>
    ))}
  </div>
</Admin>
