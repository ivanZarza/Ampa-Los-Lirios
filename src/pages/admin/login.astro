---
import '../../styles/global.css';

const error = Astro.url.searchParams.get('error');
const ok = Astro.url.searchParams.get('ok');
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>Acceso — Admin AMPA</title>
  </head>
  <body class="min-h-screen bg-verde-50 flex items-center justify-center px-4">
    <div class="w-full max-w-sm">
      <div class="text-center mb-8">
        <img src="/img/logo-ampa.png" alt="Logo AMPA Los Lirios" class="h-16 w-auto mx-auto" />
        <h1 class="text-2xl font-bold text-verde-700 mt-2">Panel de administración</h1>
        <p class="text-gray-500 text-sm mt-1">AMPA Los Lirios</p>
      </div>

      {error && (
        <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">
          {error}
        </div>
      )}

      {ok && (
        <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">
          {ok}
        </div>
      )}

      <div class="card p-6">
        <form method="POST" action="/api/auth/login">
          <label for="email" class="label-field">Correo electrónico</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            placeholder="tu@correo.com"
            class="input-field mb-4"
          />
          <button type="submit" class="btn-primary w-full">
            Enviar enlace de acceso
          </button>
        </form>
        <p class="text-xs text-gray-400 text-center mt-4">
          Recibirás un enlace en tu correo para acceder sin contraseña.
        </p>
      </div>

      <div class="text-center mt-6">
        <a href="/" class="text-verde-600 hover:text-verde-700 text-sm font-medium">
          ← Volver a la web
        </a>
      </div>
    </div>
  </body>
</html>
