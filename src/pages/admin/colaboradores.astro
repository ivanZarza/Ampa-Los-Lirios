---
import Admin from '../../layouts/Admin.astro';
import { requireAdmin } from '../../lib/auth';
import { getServiceClient } from '../../lib/supabase';

const session = await requireAdmin(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const service = getServiceClient();
let mensaje = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('_action')?.toString();

  if (action === 'create' || action === 'update') {
    let logo_ruta = form.get('logo_ruta_actual')?.toString() || '';

    const logoFile = form.get('logo') as File | null;
    if (logoFile && logoFile.size > 0) {
      const ext = logoFile.name.split('.').pop() || 'png';
      const fileName = `${Date.now()}-${Math.random().toString(36).slice(2, 8)}.${ext}`;
      const buffer = await logoFile.arrayBuffer();

      const { error: uploadErr } = await service.storage
        .from('logos')
        .upload(fileName, buffer, { contentType: logoFile.type });

      if (uploadErr) {
        error = 'Error al subir el logo: ' + uploadErr.message;
      } else {
        logo_ruta = fileName;
      }
    }

    if (!error) {
      const web_url = form.get('web_url')?.toString() || '';
      if (web_url && !web_url.startsWith('https://')) {
        error = 'La dirección web debe empezar por https://';
      } else {
        const maxOrden = form.get('orden')?.toString();
        const payload = {
          nombre: form.get('nombre')?.toString() || '',
          descripcion_corta: form.get('descripcion_corta')?.toString() || '',
          ventaja_socios: form.get('ventaja_socios')?.toString() || '',
          web_url,
          logo_ruta,
          destacado: form.get('destacado') === 'on',
          activo: form.get('activo') === 'on',
          orden: maxOrden ? parseInt(maxOrden) : 0,
        };

        if (!payload.nombre || !payload.web_url) {
          error = 'El nombre y la dirección web son obligatorios.';
        } else if (action === 'create') {
          const { error: err } = await service.from('colaboradores').insert(payload);
          if (err) error = 'Error al crear: ' + err.message;
          else mensaje = 'Colaborador añadido.';
        } else {
          const id = form.get('id')?.toString();
          const { error: err } = await service.from('colaboradores').update(payload).eq('id', id);
          if (err) error = 'Error al actualizar: ' + err.message;
          else mensaje = 'Colaborador actualizado.';
        }
      }
    }
  }

  if (action === 'delete') {
    const id = form.get('id')?.toString();
    const { error: err } = await service.from('colaboradores').update({ activo: false }).eq('id', id);
    if (err) error = 'Error al ocultar: ' + err.message;
    else mensaje = 'Colaborador ocultado.';
  }

  if (action === 'reactivar') {
    const id = form.get('id')?.toString();
    const { error: err } = await service.from('colaboradores').update({ activo: true }).eq('id', id);
    if (err) error = 'Error al reactivar: ' + err.message;
    else mensaje = 'Colaborador reactivado.';
  }
}

const { data: colaboradores } = await service
  .from('colaboradores')
  .select('*')
  .order('orden', { ascending: true });

const editId = Astro.url.searchParams.get('editar');
const editColab = editId ? colaboradores?.find(c => c.id === editId) : null;
const showForm = Astro.url.searchParams.has('nuevo') || editColab;
const bucketUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/logos`;
---

<Admin title="Gestionar colaboradores">
  <div class="flex items-center justify-between mb-6">
    <h1 class="text-2xl font-bold text-gray-900">Colaboradores</h1>
    {!showForm && (
      <a href="/admin/colaboradores?nuevo" class="btn-primary text-sm">+ Nuevo colaborador</a>
    )}
  </div>

  {mensaje && (
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">{mensaje}</div>
  )}
  {error && (
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">{error}</div>
  )}

  {showForm && (
    <div class="card p-6 mb-8">
      <h2 class="text-lg font-bold mb-4">{editColab ? 'Editar colaborador' : 'Nuevo colaborador'}</h2>
      <form method="POST" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="_action" value={editColab ? 'update' : 'create'} />
        {editColab && <input type="hidden" name="id" value={editColab.id} />}
        {editColab && <input type="hidden" name="logo_ruta_actual" value={editColab.logo_ruta || ''} />}

        <div>
          <label for="nombre" class="label-field">Nombre *</label>
          <input type="text" id="nombre" name="nombre" required class="input-field" value={editColab?.nombre || ''} />
        </div>

        <div>
          <label for="logo" class="label-field">Logo {editColab?.logo_ruta && '(deja vacío para mantener el actual)'}</label>
          {editColab?.logo_ruta && (
            <img src={`${bucketUrl}/${editColab.logo_ruta}`} alt="Logo actual" class="w-16 h-16 object-contain mb-2 rounded border" />
          )}
          <input type="file" id="logo" name="logo" accept="image/*" class="input-field" />
        </div>

        <div>
          <label for="descripcion_corta" class="label-field">Descripción corta</label>
          <textarea id="descripcion_corta" name="descripcion_corta" rows="2" class="input-field">{editColab?.descripcion_corta || ''}</textarea>
        </div>

        <div>
          <label for="ventaja_socios" class="label-field">Ventaja para socios</label>
          <input type="text" id="ventaja_socios" name="ventaja_socios" class="input-field" placeholder="Ej: 10% de descuento presentando el carnet" value={editColab?.ventaja_socios || ''} />
        </div>

        <div>
          <label for="web_url" class="label-field">Dirección web * (debe empezar por https://)</label>
          <input type="url" id="web_url" name="web_url" required class="input-field" placeholder="https://..." value={editColab?.web_url || ''} />
        </div>

        <div>
          <label for="orden" class="label-field">Orden (número)</label>
          <input type="number" id="orden" name="orden" class="input-field w-24" min="0" value={editColab?.orden ?? (colaboradores?.length || 0)} />
        </div>

        <div class="flex flex-wrap gap-4">
          <div class="flex items-center gap-2">
            <input type="checkbox" id="activo" name="activo" class="w-4 h-4 text-verde-600 rounded" checked={editColab ? editColab.activo : true} />
            <label for="activo" class="text-sm font-medium text-gray-700">Activo (visible)</label>
          </div>
          <div class="flex items-center gap-2">
            <input type="checkbox" id="destacado" name="destacado" class="w-4 h-4 text-verde-600 rounded" checked={editColab?.destacado || false} />
            <label for="destacado" class="text-sm font-medium text-gray-700">Destacado (aparece en la portada)</label>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary text-sm">{editColab ? 'Guardar cambios' : 'Añadir colaborador'}</button>
          <a href="/admin/colaboradores" class="btn-outline text-sm">Cancelar</a>
        </div>
      </form>
    </div>
  )}

  <!-- Lista -->
  {colaboradores && colaboradores.length > 0 ? (
    <div class="space-y-3">
      {colaboradores.map((c) => (
        <div class:list={['card p-4 flex flex-col sm:flex-row sm:items-center gap-3', !c.activo && 'opacity-50']}>
          <div class="flex items-center gap-3 flex-1 min-w-0">
            {c.logo_ruta ? (
              <img src={`${bucketUrl}/${c.logo_ruta}`} alt="" class="w-10 h-10 object-contain rounded flex-shrink-0" />
            ) : (
              <div class="w-10 h-10 bg-gray-100 rounded flex items-center justify-center text-gray-400 flex-shrink-0">🏪</div>
            )}
            <div class="min-w-0">
              <div class="flex items-center gap-2">
                <h3 class="font-bold text-gray-900 truncate">{c.nombre}</h3>
                {!c.activo && <span class="text-xs bg-gray-200 text-gray-600 px-2 py-0.5 rounded-full">Oculto</span>}
                {c.destacado && <span class="text-xs bg-malva-100 text-malva-700 px-2 py-0.5 rounded-full">Destacado</span>}
              </div>
              <p class="text-sm text-gray-500 truncate">{c.web_url}</p>
            </div>
          </div>
          <div class="flex gap-2 flex-shrink-0">
            <a href={`/admin/colaboradores?editar=${c.id}`} class="btn-outline text-sm !px-3 !py-1.5">Editar</a>
            {c.activo ? (
              <form method="POST" onsubmit="return confirm('¿Ocultar este colaborador de la web?')">
                <input type="hidden" name="_action" value="delete" />
                <input type="hidden" name="id" value={c.id} />
                <button type="submit" class="btn-danger !px-3 !py-1.5">Ocultar</button>
              </form>
            ) : (
              <form method="POST">
                <input type="hidden" name="_action" value="reactivar" />
                <input type="hidden" name="id" value={c.id} />
                <button type="submit" class="btn-primary text-sm !px-3 !py-1.5">Reactivar</button>
              </form>
            )}
          </div>
        </div>
      ))}
    </div>
  ) : (
    <div class="bg-gray-50 rounded-xl p-8 text-center">
      <p class="text-gray-500">No hay colaboradores todavía.</p>
    </div>
  )}
</Admin>
