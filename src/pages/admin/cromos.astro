---
import Admin from '../../layouts/Admin.astro';
import { requireAdmin } from '../../lib/auth';
import { getServiceClient } from '../../lib/supabase';

const session = await requireAdmin(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const service = getServiceClient();
let mensaje = '';
let error = '';

const SECRETS_INFO: Record<string, { trigger: string; rarity: string; emoji: string }> = {
  logo7:      { trigger: 'Pulsar el logo 🌿 siete veces',                      rarity: 'Común',      emoji: '🐱' },
  ladybug:    { trigger: 'Encontrar la mariquita oculta en la esquina',         rarity: 'Común',      emoji: '🐞' },
  lirios:     { trigger: 'Escribir "lirios" con el teclado',                    rarity: 'Raro',       emoji: '🌸' },
  konami:     { trigger: 'Código Konami: ↑↑↓↓←→←→BA',                          rarity: 'Legendario', emoji: '🐲' },
  comunidad:  { trigger: 'Doble clic en la palabra "comunidad"',                rarity: 'Raro',       emoji: '🦊' },
  nocturno:   { trigger: 'Visitar la web después de las 22:00',                 rarity: 'Épico',      emoji: '🦉' },
  privacidad: { trigger: 'Hacer scroll hasta el final de Privacidad',           rarity: 'Raro',       emoji: '🐢' },
  estrella:   { trigger: 'Encontrar la estrella oculta en Fiestas',             rarity: 'Épico',      emoji: '⭐' },
  camara:     { trigger: 'Pulsar 3 veces el icono 📸 en Galería',              rarity: 'Raro',       emoji: '🦋' },
  coleccion:  { trigger: 'Encontrar los 9 anteriores (se desbloquea solo)',     rarity: 'Legendario', emoji: '🦄' },
};

const SLUG_ORDER = ['logo7','ladybug','lirios','konami','comunidad','nocturno','privacidad','estrella','camara','coleccion'];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const slug = form.get('slug')?.toString();

  if (slug && SECRETS_INFO[slug]) {
    let imagen_ruta = form.get('imagen_ruta_actual')?.toString() || null;

    const imageFile = form.get('imagen') as File | null;
    if (imageFile && imageFile.size > 0) {
      const ext = imageFile.name.split('.').pop() || 'png';
      const fileName = `${slug}.${ext}`;

      // Delete old file if exists
      if (imagen_ruta) {
        await service.storage.from('cromos').remove([imagen_ruta]);
      }

      const buffer = await imageFile.arrayBuffer();
      const { error: uploadErr } = await service.storage
        .from('cromos')
        .upload(fileName, buffer, { contentType: imageFile.type, upsert: true });

      if (uploadErr) {
        error = 'Error al subir la imagen: ' + uploadErr.message;
      } else {
        imagen_ruta = fileName;
      }
    }

    if (!error) {
      const payload: Record<string, any> = {
        nombre: form.get('nombre')?.toString() || '',
        descripcion: form.get('descripcion')?.toString() || '',
        color: form.get('color')?.toString() || '#4a8f4a',
      };
      if (imagen_ruta !== undefined) payload.imagen_ruta = imagen_ruta;

      const { error: err } = await service.from('cromos').update(payload).eq('slug', slug);
      if (err) error = 'Error al guardar: ' + err.message;
      else mensaje = '¡Cromo actualizado!';
    }
  }
}

const { data: cromos } = await service.from('cromos').select('*');
const cromosMap = new Map((cromos || []).map(c => [c.slug, c]));
const bucketUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/cromos`;

const editSlug = Astro.url.searchParams.get('editar');
const editCromo = editSlug ? cromosMap.get(editSlug) : null;
---

<Admin title="Cromos - Búsqueda del tesoro">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">🏆 Búsqueda del tesoro</h1>
    <p class="text-gray-500 text-sm mt-1">
      Personaliza los cromos que los niños encuentran en los secretos ocultos de la web.
      Sube las imágenes de los personajes que quieras usar.
    </p>
  </div>

  {mensaje && (
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">{mensaje}</div>
  )}
  {error && (
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">{error}</div>
  )}

  {editCromo && editSlug && SECRETS_INFO[editSlug] && (
    <div class="card p-6 mb-8">
      <h2 class="text-lg font-bold mb-1">Editar cromo #{SLUG_ORDER.indexOf(editSlug) + 1}</h2>
      <p class="text-sm text-gray-400 mb-4">
        Secreto: {SECRETS_INFO[editSlug].trigger}
      </p>
      <form method="POST" enctype="multipart/form-data" class="space-y-4">
        <input type="hidden" name="slug" value={editSlug} />
        <input type="hidden" name="imagen_ruta_actual" value={editCromo.imagen_ruta || ''} />

        <div>
          <label for="nombre" class="label-field">Nombre del personaje *</label>
          <input type="text" id="nombre" name="nombre" required class="input-field"
                 value={editCromo.nombre} placeholder="Ej: Doraemon, Pikachu..." />
        </div>

        <div>
          <label for="descripcion" class="label-field">Descripción corta</label>
          <input type="text" id="descripcion" name="descripcion" class="input-field"
                 value={editCromo.descripcion} placeholder="Ej: El gato cósmico del futuro" />
        </div>

        <div>
          <label for="imagen" class="label-field">
            Imagen del personaje
            {editCromo.imagen_ruta ? ' (deja vacío para mantener la actual)' : ''}
          </label>
          {editCromo.imagen_ruta && (
            <div class="mb-2 flex items-center gap-3">
              <img src={`${bucketUrl}/${editCromo.imagen_ruta}`} alt="Imagen actual"
                   class="w-20 h-20 object-contain rounded-xl border border-gray-200 bg-gray-50 p-1" />
              <span class="text-xs text-gray-400">Imagen actual</span>
            </div>
          )}
          <input type="file" id="imagen" name="imagen" accept="image/*" class="input-field" />
          <p class="text-xs text-gray-400 mt-1">PNG o JPG transparente. Recomendado: 200×200 px.</p>
        </div>

        <div>
          <label for="color" class="label-field">Color de la celebración</label>
          <div class="flex items-center gap-3">
            <input type="color" id="color" name="color" value={editCromo.color}
                   class="w-10 h-10 rounded border border-gray-200 cursor-pointer" />
            <span class="text-sm text-gray-500">Color de los confetis al encontrar este cromo</span>
          </div>
        </div>

        <div class="flex gap-3 pt-2">
          <button type="submit" class="btn-primary text-sm">Guardar cambios</button>
          <a href="/admin/cromos" class="btn-outline text-sm">Cancelar</a>
        </div>
      </form>
    </div>
  )}

  <!-- Grid de cromos -->
  <div class="grid sm:grid-cols-2 gap-4">
    {SLUG_ORDER.map((slug, i) => {
      const cromo = cromosMap.get(slug);
      const info = SECRETS_INFO[slug];
      const hasImage = cromo?.imagen_ruta;

      return (
        <div class="card p-4">
          <div class="flex items-start gap-4">
            <div class="w-16 h-16 rounded-xl bg-gray-50 border border-gray-200 flex items-center justify-center flex-shrink-0 overflow-hidden">
              {hasImage ? (
                <img src={`${bucketUrl}/${cromo.imagen_ruta}`} alt={cromo?.nombre}
                     class="w-14 h-14 object-contain" />
              ) : (
                <span class="text-3xl">{info.emoji}</span>
              )}
            </div>
            <div class="flex-1 min-w-0">
              <div class="flex items-center gap-2 mb-1">
                <span class="text-xs text-gray-400 font-mono">#{i + 1}</span>
                <span class:list={[
                  'text-[10px] font-bold px-2 py-0.5 rounded-full',
                  info.rarity === 'Común' && 'bg-gray-100 text-gray-600',
                  info.rarity === 'Raro' && 'bg-blue-100 text-blue-700',
                  info.rarity === 'Épico' && 'bg-purple-100 text-purple-700',
                  info.rarity === 'Legendario' && 'bg-amber-100 text-amber-700',
                ]}>{info.rarity}</span>
              </div>
              <h3 class="font-bold text-gray-900 text-sm">{cromo?.nombre || '???'}</h3>
              <p class="text-xs text-gray-400 mt-0.5 truncate">{info.trigger}</p>
              {!hasImage && (
                <p class="text-[10px] text-amber-600 mt-1">⚠️ Sin imagen — se muestra emoji</p>
              )}
            </div>
            <a href={`/admin/cromos?editar=${slug}`}
               class="btn-outline text-xs !px-3 !py-1.5 flex-shrink-0 self-center">
              Editar
            </a>
          </div>
        </div>
      );
    })}
  </div>

  <div class="mt-8 bg-malva-50 rounded-xl p-5 border border-malva-100">
    <h3 class="font-bold text-malva-800 text-sm mb-2">💡 ¿Cómo funciona?</h3>
    <ul class="text-sm text-malva-700 space-y-1">
      <li>• Los niños descubren secretos ocultos por la web y coleccionan <strong>cromos</strong>.</li>
      <li>• Sube las imágenes de los personajes que quieras (Doraemon, Pikachu, Bob Esponja…).</li>
      <li>• Cada cromo tiene un secreto diferente para encontrarlo (¡no se lo cuentes a nadie!).</li>
      <li>• Los cromos se guardan en el navegador de cada niño. Se ven en el botón 🏆.</li>
    </ul>
  </div>
</Admin>
