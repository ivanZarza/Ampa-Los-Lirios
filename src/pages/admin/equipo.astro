---
import Admin from '../../layouts/Admin.astro';
import { requireSuperAdmin } from '../../lib/auth';
import { getServiceClient } from '../../lib/supabase';

const session = await requireSuperAdmin(Astro.cookies);
if (!session) return Astro.redirect('/admin/login');

const service = getServiceClient();
let mensaje = '';
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = form.get('action')?.toString();

  if (action === 'add') {
    const email = form.get('email')?.toString().trim().toLowerCase();
    const password = form.get('password')?.toString();
    const nombre = form.get('nombre')?.toString().trim() || '';

    if (!email || !password) {
      error = 'Introduce email y contraseña.';
    } else if (password.length < 6) {
      error = 'La contraseña debe tener al menos 6 caracteres.';
    } else {
      const { data: exists } = await service
        .from('admins')
        .select('email')
        .eq('email', email)
        .single();

      if (exists) {
        error = 'Ese email ya es administrador.';
      } else {
        const { data: authUser, error: authErr } = await service.auth.admin.createUser({
          email,
          password,
          email_confirm: true,
        });

        if (authErr) {
          if (authErr.message?.includes('already been registered')) {
            const existingUser = (await service.auth.admin.listUsers()).data?.users?.find(u => u.email === email);
            if (existingUser) {
              await service.auth.admin.updateUserById(existingUser.id, { password });
            }
          } else {
            error = 'Error al crear usuario: ' + authErr.message;
          }
        }

        if (!error) {
          const { error: insertErr } = await service
            .from('admins')
            .insert({ email, nombre });

          if (insertErr) {
            error = 'Error al guardar: ' + insertErr.message;
          } else {
            mensaje = `¡${nombre || email} añadido como administrador!`;
          }
        }
      }
    }
  } else if (action === 'remove') {
    const email = form.get('email')?.toString();
    if (email === session.user.email) {
      error = 'No puedes eliminarte a ti mismo.';
    } else if (email) {
      await service.from('admins').delete().eq('email', email);

      const { data: users } = await service.auth.admin.listUsers();
      const user = users?.users?.find(u => u.email === email);
      if (user) {
        await service.auth.admin.deleteUser(user.id);
      }

      mensaje = `Administrador ${email} eliminado.`;
    }
  } else if (action === 'reset-password') {
    const email = form.get('email')?.toString();
    const newPassword = form.get('new_password')?.toString();

    if (!email || !newPassword) {
      error = 'Introduce la nueva contraseña.';
    } else if (newPassword.length < 6) {
      error = 'La contraseña debe tener al menos 6 caracteres.';
    } else {
      const { data: users } = await service.auth.admin.listUsers();
      const user = users?.users?.find(u => u.email === email);

      if (user) {
        const { error: updateErr } = await service.auth.admin.updateUserById(user.id, {
          password: newPassword,
        });
        if (updateErr) error = 'Error al cambiar la contraseña: ' + updateErr.message;
        else mensaje = `Contraseña de ${email} actualizada.`;
      } else {
        error = 'Usuario no encontrado en el sistema de autenticación.';
      }
    }
  }
}

let adminList: any[] = [];
try {
  const { data: admins } = await service.from('admins').select('*').order('created_at', { ascending: true });
  adminList = admins || [];
} catch {
  const { data: admins } = await service.from('admins').select('email');
  adminList = admins || [];
}
---

<Admin title="Equipo - Administradores">
  <div class="mb-6">
    <h1 class="text-2xl font-bold text-gray-900">👥 Equipo de administradores</h1>
    <p class="text-gray-500 text-sm mt-1">
      Solo tú (superadmin) puedes ver esta página. Añade o elimina personas que pueden acceder al panel.
    </p>
  </div>

  {mensaje && (
    <div class="bg-green-50 border border-green-200 text-green-700 px-4 py-3 rounded-lg mb-4 text-sm">{mensaje}</div>
  )}
  {error && (
    <div class="bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-lg mb-4 text-sm">{error}</div>
  )}

  <div class="card p-6 mb-8">
    <h2 class="text-lg font-bold text-gray-900 mb-4">Añadir administrador</h2>
    <form method="POST" class="space-y-4">
      <input type="hidden" name="action" value="add" />

      <div>
        <label for="nombre" class="label-field">Nombre (opcional)</label>
        <input type="text" id="nombre" name="nombre" class="input-field"
               placeholder="Ej: María García" />
      </div>

      <div>
        <label for="email" class="label-field">Correo electrónico *</label>
        <input type="email" id="email" name="email" required class="input-field"
               placeholder="correo@ejemplo.com" />
      </div>

      <div>
        <label for="password" class="label-field">Contraseña *</label>
        <input type="password" id="password" name="password" required minlength="6" class="input-field"
               placeholder="Mínimo 6 caracteres" />
      </div>

      <button type="submit" class="btn-primary text-sm">Añadir administrador</button>
    </form>
  </div>

  <h2 class="text-lg font-bold text-gray-900 mb-4">Administradores actuales</h2>
  <div class="space-y-3">
    {adminList.map((admin) => {
      const isMe = admin.email === session.user.email;
      return (
        <div class="card p-4 flex items-center justify-between gap-4">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2">
              <span class="font-bold text-gray-900 text-sm">{admin.nombre || admin.email}</span>
              {isMe && (
                <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-verde-100 text-verde-700">
                  Superadmin (tú)
                </span>
              )}
            </div>
            <p class="text-xs text-gray-400 truncate">{admin.email}</p>
          </div>

          {!isMe && (
            <div class="flex items-center gap-2 flex-shrink-0">
              <details class="relative">
                <summary class="btn-outline text-xs !px-3 !py-1.5 cursor-pointer list-none">
                  Cambiar contraseña
                </summary>
                <div class="absolute right-0 top-full mt-1 bg-white rounded-lg shadow-xl border border-gray-200 p-4 z-10 w-64">
                  <form method="POST" class="space-y-2">
                    <input type="hidden" name="action" value="reset-password" />
                    <input type="hidden" name="email" value={admin.email} />
                    <label class="label-field text-xs">Nueva contraseña</label>
                    <input type="password" name="new_password" required minlength="6"
                           class="input-field text-sm" placeholder="Mínimo 6 caracteres" />
                    <button type="submit" class="btn-primary text-xs w-full">Guardar</button>
                  </form>
                </div>
              </details>

              <form method="POST">
                <input type="hidden" name="action" value="remove" />
                <input type="hidden" name="email" value={admin.email} />
                <button type="submit" class="btn-danger text-xs !px-3 !py-1.5"
                        onclick="return confirm('¿Eliminar a este administrador? Perderá el acceso al panel.')">
                  Eliminar
                </button>
              </form>
            </div>
          )}
        </div>
      );
    })}
  </div>

  <div class="mt-8 bg-malva-50 rounded-xl p-5 border border-malva-100">
    <h3 class="font-bold text-malva-800 text-sm mb-2">💡 ¿Cómo funciona?</h3>
    <ul class="text-sm text-malva-700 space-y-1">
      <li>• Solo tú (superadmin) puedes añadir o eliminar administradores.</li>
      <li>• Cada admin accede con su email y contraseña en <code>/admin/login</code>.</li>
      <li>• Puedes cambiar la contraseña de cualquier admin desde aquí.</li>
      <li>• No puedes eliminarte a ti mismo para no quedarte fuera.</li>
    </ul>
  </div>
</Admin>
