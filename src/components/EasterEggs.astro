---
import { supabase } from '../lib/supabase';

let dbCromos: any[] = [];
try {
  const { data } = await supabase.from('cromos').select('*');
  dbCromos = data || [];
} catch {}

const bucketUrl = `${import.meta.env.PUBLIC_SUPABASE_URL}/storage/v1/object/public/cromos`;

const HARDCODED = [
  { slug: 'logo7', emoji: '🐱', rarity: 'comun', hint: 'Prueba a tocar el logo varias veces…',
    name: 'Gato Positivo', theme: 'Actitud positiva', desc: 'Con buena actitud, todo sale mejor' },
  { slug: 'ladybug', emoji: '🐞', rarity: 'comun', hint: 'Mira bien las esquinas de la pantalla…',
    name: 'Mariquita de la Suerte', theme: 'Amistad', desc: 'Los buenos amigos son el mayor tesoro' },
  { slug: 'lirios', emoji: '🌸', rarity: 'raro', hint: 'Escribe el nombre de nuestras flores…',
    name: 'Flor de Lirio', theme: 'Creatividad', desc: 'Tu imaginación puede crear mundos enteros' },
  { slug: 'konami', emoji: '🐲', rarity: 'legendario', hint: '↑↑↓↓←→←→BA… ¿te suena?',
    name: 'Dragón Imparable', theme: 'Superación', desc: 'Cada intento te acerca más a tu meta' },
  { slug: 'comunidad', emoji: '🦊', rarity: 'raro', hint: 'Busca la palabra "comunidad" en la portada…',
    name: 'Zorro Amigo', theme: 'Respeto', desc: 'Tratarnos bien hace que todos estemos mejor' },
  { slug: 'nocturno', emoji: '🦉', rarity: 'epico', hint: 'Algunos secretos solo se ven de noche…',
    name: 'Búho Valiente', theme: 'Confianza en uno mismo', desc: 'Confía en ti, eres más valiente de lo que crees' },
  { slug: 'privacidad', emoji: '🐢', rarity: 'raro', hint: 'Alguien que lee la letra pequeña merece un premio…',
    name: 'Tortuga Responsable', theme: 'Responsabilidad', desc: 'Ser responsable es cosa de mayores… ¡y de valientes!' },
  { slug: 'estrella', emoji: '⭐', rarity: 'epico', hint: 'Hay una estrella muy pequeña en la página de fiestas…',
    name: 'Estrella del Esfuerzo', theme: 'Esfuerzo', desc: 'Cuando te esfuerzas, brillas con luz propia' },
  { slug: 'camara', emoji: '🦋', rarity: 'raro', hint: 'Toca el icono de la cámara en la galería…',
    name: 'Mariposa Protectora', theme: 'Cuidar a los más pequeños', desc: 'Los más pequeños necesitan nuestro cariño y ejemplo' },
  { slug: 'coleccion', emoji: '🦄', rarity: 'legendario', hint: 'Encuentra los 9 cromos anteriores…',
    name: 'Unicornio del Equipo', theme: 'Trabajo en equipo', desc: 'Juntos somos más fuertes que por separado' },
];

const cromosData = HARDCODED.map(h => {
  const db = dbCromos.find(c => c.slug === h.slug);
  return {
    id: h.slug,
    emoji: h.emoji,
    name: db?.nombre || h.name || h.slug,
    desc: db?.descripcion || h.desc || '',
    rarity: h.rarity,
    hint: h.hint,
    theme: db?.tematica || h.theme || '',
    color: db?.color || '#4a8f4a',
    imageUrl: db?.imagen_ruta ? `${bucketUrl}/${db.imagen_ruta}` : null,
  };
});

let musicUrl: string | null = null;
try {
  const { data: files } = await supabase.storage.from('cromos').list();
  const musicFile = files?.find((f: any) => f.name.startsWith('celebration-music'));
  if (musicFile) {
    musicUrl = `${bucketUrl}/${musicFile.name}`;
  }
} catch {}
---

<!-- Cromo data for client -->
<div id="cromos-config" data-cromos={JSON.stringify(cromosData)} data-music={musicUrl || ''} style="display:none"></div>

<!-- Hidden ladybug (secret 2) -->
<div
  id="secret-ladybug"
  class="fixed bottom-3 left-3 w-4 h-4 cursor-pointer z-40 opacity-[0.08] hover:opacity-30
         transition-opacity duration-[2000ms] text-[10px] leading-none select-none"
  aria-hidden="true"
>🐞</div>

<!-- Hidden star on /fiestas (secret 8) -->
<div
  id="secret-star"
  class="hidden fixed top-[40%] right-3 w-3 h-3 cursor-pointer z-40 opacity-[0.06] hover:opacity-25
         transition-opacity duration-[2000ms] text-[8px] leading-none select-none"
  aria-hidden="true"
>⭐</div>

<!-- Album button -->
<button
  id="album-btn"
  class="fixed bottom-4 right-4 w-12 h-12 rounded-full bg-white shadow-lg border-2 border-verde-200
         z-50 flex items-center justify-center text-xl hover:scale-110 hover:shadow-xl
         transition-all duration-300 cursor-pointer opacity-0 pointer-events-none"
  aria-label="Álbum de cromos"
>
  <span>🏆</span>
  <span id="album-badge"
    class="absolute -top-1 -right-1 w-5 h-5 bg-verde-500 text-white text-[10px] font-bold
           rounded-full flex items-center justify-center">0</span>
</button>

<!-- Album overlay -->
<div id="album-overlay" class="fixed inset-0 z-[200] bg-black/60 backdrop-blur-sm
     flex items-center justify-center p-4 opacity-0 pointer-events-none transition-all duration-500">
  <div id="album-card" class="bg-white rounded-3xl shadow-2xl max-w-md w-full max-h-[85vh] overflow-y-auto
       transform scale-95 transition-transform duration-500 relative">
    <div class="sticky top-0 bg-white rounded-t-3xl border-b border-gray-100 p-5 flex items-center justify-between z-10">
      <div>
        <h2 class="text-lg font-extrabold text-gray-900">Álbum de cromos</h2>
        <p id="album-count" class="text-xs text-gray-400 mt-0.5">0 de 10 encontrados</p>
      </div>
      <button id="album-close" class="w-8 h-8 rounded-full bg-gray-100 flex items-center justify-center
              text-gray-500 hover:bg-gray-200 transition-colors cursor-pointer" aria-label="Cerrar">✕</button>
    </div>
    <div id="album-grid" class="p-5 grid grid-cols-2 gap-3"></div>
    <div class="p-5 pt-0">
      <p id="album-hint" class="text-xs text-gray-400 text-center italic"></p>
    </div>
  </div>
</div>

<!-- Celebration overlay (single cromo) -->
<div id="celebration" class="fixed inset-0 z-[300] flex items-center justify-center p-4
     bg-black/50 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300">
  <div id="celeb-card" class="bg-white rounded-3xl shadow-2xl p-8 text-center max-w-xs w-full
       transform scale-75 transition-transform duration-500">
    <div id="celeb-visual" class="mb-3 flex items-center justify-center"></div>
    <div id="celeb-label" class="text-xs font-bold text-verde-500 uppercase tracking-widest mb-1">¡Nuevo cromo!</div>
    <h3 id="celeb-name" class="text-xl font-extrabold text-gray-900 mb-1"></h3>
    <p id="celeb-desc" class="text-sm text-gray-500"></p>
    <div id="celeb-rarity" class="mt-3 text-xs font-bold px-3 py-1 rounded-full inline-block"></div>
    <p id="celeb-hint" class="text-[11px] text-gray-400 mt-4 opacity-60">Toca en cualquier sitio para cerrar</p>
  </div>
</div>

<!-- Particle container -->
<div id="particles" class="fixed inset-0 pointer-events-none z-[299] overflow-hidden" aria-hidden="true"></div>

<!-- Grand finale overlay (complete collection) -->
<div id="grand-finale" class="fixed inset-0 z-[400]"
     style="opacity:0; pointer-events:none; transition: opacity 1.2s ease">
  <div class="absolute inset-0 bg-gradient-to-b from-[#070720] via-[#0e0e3a] to-[#070720]"></div>
  <div id="finale-stars" class="absolute inset-0 overflow-hidden"></div>
  <div id="finale-confetti-box" class="absolute inset-0 overflow-hidden pointer-events-none"></div>
  <div class="relative z-10 flex flex-col items-center justify-center h-full px-6 text-center">
    <div id="finale-characters" class="absolute inset-0 pointer-events-none"></div>
    <p id="finale-question" class="text-white/90 text-xl md:text-2xl font-medium max-w-md leading-relaxed"
       style="opacity:0; transition: opacity 1.2s ease">
      ¿Sabes cuál es el secreto de la fórmula de la felicidad?
    </p>
    <h1 id="finale-answer" class="finale-glow mt-4"
        style="opacity:0; transform:scale(0.5); transition: all 1.2s cubic-bezier(0.16, 1, 0.3, 1)">
      ¡ERES TÚ!
    </h1>
    <p id="finale-subtitle" class="text-white/50 text-base md:text-lg mt-6 max-w-sm"
       style="opacity:0; transition: opacity 1s ease">
      Has descubierto todos los secretos de Los Lirios 🌿
    </p>
    <button id="finale-close" class="mt-10 px-8 py-3 bg-white/10 backdrop-blur-sm text-white/80 rounded-full
             border border-white/20 hover:bg-white/20 hover:text-white transition-all duration-300
             cursor-pointer text-sm tracking-wide"
             style="opacity:0; pointer-events:none; transition: opacity 0.8s ease">
      Volver a la realidad
    </button>
  </div>
</div>

<style>
  /* Rain — items fall from top, loop continuously */
  @keyframes anim-rain {
    0% { transform: translateY(-40px) rotate(0deg); opacity: 0; }
    10% { opacity: 1; }
    90% { opacity: 0.7; }
    100% { transform: translateY(105vh) rotate(var(--rot, 540deg)); opacity: 0; }
  }
  .rain-particle {
    position: fixed;
    top: -40px;
    pointer-events: none;
    animation: anim-rain var(--dur, 3s) linear var(--del, 0s) infinite;
  }

  /* Burst — radial explosion from center */
  @keyframes anim-burst {
    0% { transform: translate(0, 0) scale(1); opacity: 1; }
    60% { opacity: 0.9; }
    100% { transform: translate(var(--px), var(--py)) scale(var(--end-scale, 0.3)); opacity: 0; }
  }
  .burst-particle {
    position: fixed;
    pointer-events: none;
    animation: anim-burst var(--dur, 1.8s) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* Reveal — large item scales up from center */
  @keyframes anim-reveal {
    0% { transform: scale(0) rotate(-10deg); opacity: 0; }
    60% { transform: scale(1.15) rotate(3deg); opacity: 1; }
    80% { transform: scale(0.95) rotate(-1deg); opacity: 1; }
    100% { transform: scale(1) rotate(0deg); opacity: 1; }
  }
  .reveal-item {
    position: fixed;
    pointer-events: none;
    animation: anim-reveal 0.8s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
  }

  /* Shimmer ring behind reveal */
  @keyframes anim-shimmer {
    0% { transform: scale(0.5); opacity: 0; }
    50% { opacity: 0.6; }
    100% { transform: scale(2.5); opacity: 0; }
  }
  .reveal-shimmer {
    position: fixed;
    pointer-events: none;
    border-radius: 50%;
    border: 3px solid;
    animation: anim-shimmer 1.5s ease-out infinite;
  }

  /* Firework sparks */
  @keyframes anim-fw-spark {
    0% { transform: translate(0, 0) scale(1); opacity: 1; }
    100% { transform: translate(var(--sx), var(--sy)) scale(0); opacity: 0; }
  }
  .fw-spark {
    position: fixed;
    pointer-events: none;
    animation: anim-fw-spark var(--dur, 1.2s) cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .cromo {
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cromo:hover {
    transform: scale(1.05);
  }
  .cromo.found {
    animation: cromo-shine 2s ease-in-out;
  }
  @keyframes cromo-shine {
    0%, 100% { box-shadow: 0 0 0 0 transparent; }
    50% { box-shadow: 0 0 20px 4px rgba(74, 143, 74, 0.3); }
  }
  @keyframes hint-pulse {
    0%, 100% { opacity: 0.05; }
    50% { opacity: 0.15; }
  }
  .hint-pulse {
    animation: hint-pulse 3s ease-in-out infinite;
  }
  .celeb-bounce {
    animation: celeb-bounce 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
  @keyframes celeb-bounce {
    0% { transform: scale(0.3); }
    50% { transform: scale(1.15); }
    100% { transform: scale(1); }
  }

  /* === Grand finale === */
  .finale-glow {
    font-size: clamp(3rem, 14vw, 9rem);
    font-weight: 900;
    line-height: 1;
    background: linear-gradient(135deg, #ffd700, #ffaa00, #ff8c00, #ffd700);
    background-size: 300% 300%;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    filter: drop-shadow(0 0 40px rgba(255, 215, 0, 0.5)) drop-shadow(0 0 80px rgba(255, 170, 0, 0.25));
    animation: glow-shift 3s ease-in-out infinite;
  }
  @keyframes glow-shift {
    0%, 100% { background-position: 0% 50%; }
    50% { background-position: 100% 50%; }
  }
  .finale-star {
    position: absolute;
    background: white;
    border-radius: 50%;
    animation: twinkle var(--dur) ease-in-out var(--del) infinite;
  }
  @keyframes twinkle {
    0%, 100% { opacity: 0.1; transform: scale(1); }
    50% { opacity: 1; transform: scale(2); }
  }
  .finale-char {
    position: absolute;
    animation: fchar var(--dur) ease-in-out var(--del) infinite;
    filter: drop-shadow(0 0 12px rgba(255,255,255,0.35));
  }
  @keyframes fchar {
    0%, 100% { transform: translate(-50%,-50%) translateY(0) rotate(0deg); }
    25% { transform: translate(-50%,-50%) translateY(-18px) rotate(6deg); }
    75% { transform: translate(-50%,-50%) translateY(12px) rotate(-4deg); }
  }
  .finale-confetti {
    position: absolute;
    top: -12px;
    pointer-events: none;
    animation: fconf var(--dur) linear var(--del) forwards;
  }
  @keyframes fconf {
    0% { transform: translateY(-20px) rotate(0deg); opacity: 1; }
    80% { opacity: 0.7; }
    100% { transform: translateY(100vh) rotate(1080deg); opacity: 0; }
  }
</style>

<script>
  interface Cromo {
    id: string;
    emoji: string;
    name: string;
    desc: string;
    theme: string;
    rarity: 'comun' | 'raro' | 'epico' | 'legendario';
    hint: string;
    color: string;
    imageUrl: string | null;
  }

  const RARITY_LABELS: Record<string, { label: string; bg: string; text: string }> = {
    comun:      { label: 'Común',      bg: 'bg-gray-100',   text: 'text-gray-600' },
    raro:       { label: 'Raro',       bg: 'bg-blue-100',   text: 'text-blue-700' },
    epico:      { label: 'Épico',      bg: 'bg-purple-100', text: 'text-purple-700' },
    legendario: { label: 'Legendario', bg: 'bg-amber-100',  text: 'text-amber-700' },
  };

  const ANIM_TYPES: Record<string, string> = {
    logo7: 'burst',
    ladybug: 'rain',
    lirios: 'reveal',
    konami: 'fireworks',
    comunidad: 'rain',
    nocturno: 'burst',
    privacidad: 'reveal',
    estrella: 'fireworks',
    camara: 'rain',
  };

  let celebAnimInterval: ReturnType<typeof setInterval> | null = null;

  const CARD_THEMES: Record<string, {
    font: string; labelText: string; labelColor: string;
    titleColor: string; descColor: string; hintColor: string;
    cardBg: string; cardBorder: string;
  }> = {
    logo7: {
      font: "'Fredoka', sans-serif",
      labelText: '¡Miau!',
      labelColor: '#ea580c',
      titleColor: '#9a3412',
      descColor: '#c2410c',
      hintColor: '#d4a373',
      cardBg: 'linear-gradient(135deg, #fff7ed, #ffedd5)',
      cardBorder: '2px solid #fdba74',
    },
    ladybug: {
      font: "'Fredoka', sans-serif",
      labelText: '¡Qué suerte!',
      labelColor: '#dc2626',
      titleColor: '#991b1b',
      descColor: '#b91c1c',
      hintColor: '#fca5a5',
      cardBg: 'linear-gradient(135deg, #fef2f2, #fee2e2)',
      cardBorder: '2px solid #fca5a5',
    },
    lirios: {
      font: "'Pacifico', cursive",
      labelText: '¡Floreciendo!',
      labelColor: '#c026d3',
      titleColor: '#86198f',
      descColor: '#a21caf',
      hintColor: '#d8b4fe',
      cardBg: 'linear-gradient(135deg, #fdf4ff, #f5d0fe)',
      cardBorder: '2px solid #e879f9',
    },
    konami: {
      font: "'Bangers', cursive",
      labelText: '¡POWER UP!',
      labelColor: '#a78bfa',
      titleColor: '#e0e7ff',
      descColor: '#c4b5fd',
      hintColor: '#6366f1',
      cardBg: 'linear-gradient(135deg, #0f0f23, #1a1a3e)',
      cardBorder: '2px solid #8b5cf6',
    },
    comunidad: {
      font: "'Fredoka', sans-serif",
      labelText: '¡Juntos!',
      labelColor: '#ea580c',
      titleColor: '#78350f',
      descColor: '#92400e',
      hintColor: '#d4a373',
      cardBg: 'linear-gradient(135deg, #fffbeb, #fef3c7)',
      cardBorder: '2px solid #fbbf24',
    },
    nocturno: {
      font: "'Creepster', cursive",
      labelText: '¡Búho nocturno!',
      labelColor: '#818cf8',
      titleColor: '#e0e7ff',
      descColor: '#c7d2fe',
      hintColor: '#6366f1',
      cardBg: 'linear-gradient(135deg, #1e1b4b, #312e81)',
      cardBorder: '2px solid #6366f1',
    },
    privacidad: {
      font: "'Caveat', cursive",
      labelText: '¡Bien leído!',
      labelColor: '#059669',
      titleColor: '#064e3b',
      descColor: '#047857',
      hintColor: '#6ee7b7',
      cardBg: 'linear-gradient(135deg, #ecfdf5, #d1fae5)',
      cardBorder: '2px solid #6ee7b7',
    },
    estrella: {
      font: "'Orbitron', sans-serif",
      labelText: '¡ESTELAR!',
      labelColor: '#d97706',
      titleColor: '#78350f',
      descColor: '#92400e',
      hintColor: '#fbbf24',
      cardBg: 'linear-gradient(135deg, #fffbeb, #fef3c7)',
      cardBorder: '2px solid #f59e0b',
    },
    camara: {
      font: "'Pacifico', cursive",
      labelText: '¡Flash!',
      labelColor: '#0891b2',
      titleColor: '#164e63',
      descColor: '#0e7490',
      hintColor: '#67e8f9',
      cardBg: 'linear-gradient(135deg, #ecfeff, #cffafe)',
      cardBorder: '2px solid #67e8f9',
    },
  };

  function loadCromos(): Cromo[] {
    const el = document.getElementById('cromos-config');
    if (!el) return [];
    try { return JSON.parse(el.dataset.cromos || '[]'); } catch { return []; }
  }

  function loadMusicUrl(): string | null {
    const el = document.getElementById('cromos-config');
    const url = el?.dataset.music;
    return url || null;
  }

  let CROMOS = loadCromos();
  let MUSIC_URL = loadMusicUrl();

  function getFound(): Set<string> {
    try {
      const raw = localStorage.getItem('ampa-cromos');
      return new Set(raw ? JSON.parse(raw) : []);
    } catch { return new Set(); }
  }

  function saveFound(found: Set<string>) {
    try { localStorage.setItem('ampa-cromos', JSON.stringify([...found])); } catch {}
  }

  let found = getFound();

  const albumBtn     = document.getElementById('album-btn')!;
  const albumBadge   = document.getElementById('album-badge')!;
  const albumOverlay = document.getElementById('album-overlay')!;
  const albumCard    = document.getElementById('album-card')!;
  const albumGrid    = document.getElementById('album-grid')!;
  const albumCount   = document.getElementById('album-count')!;
  const albumHint    = document.getElementById('album-hint')!;
  const albumClose   = document.getElementById('album-close')!;
  const celebration  = document.getElementById('celebration')!;
  const celebCard    = document.getElementById('celeb-card')!;
  const celebVisual  = document.getElementById('celeb-visual')!;
  const celebName    = document.getElementById('celeb-name')!;
  const celebDesc    = document.getElementById('celeb-desc')!;
  const celebRarity  = document.getElementById('celeb-rarity')!;
  const particles    = document.getElementById('particles')!;
  const grandFinale     = document.getElementById('grand-finale')!;
  const finaleStars     = document.getElementById('finale-stars')!;
  const finaleQuestion  = document.getElementById('finale-question')!;
  const finaleAnswer    = document.getElementById('finale-answer')!;
  const finaleSubtitle  = document.getElementById('finale-subtitle')!;
  const finaleClose     = document.getElementById('finale-close')!;
  const finaleChars     = document.getElementById('finale-characters')!;
  const finaleConfetti  = document.getElementById('finale-confetti-box')!;
  const celebLabel      = document.getElementById('celeb-label')!;
  const celebHint       = document.getElementById('celeb-hint')!;

  if (!document.querySelector('link[data-easter-fonts]')) {
    const fl = document.createElement('link');
    fl.rel = 'stylesheet';
    fl.dataset.easterFonts = '';
    fl.href = 'https://fonts.googleapis.com/css2?family=Bangers&family=Caveat:wght@700&family=Creepster&family=Fredoka:wght@600&family=Orbitron:wght@700&family=Pacifico&display=swap';
    document.head.appendChild(fl);
  }

  function cromoVisualHTML(cromo: Cromo, sizeClass: string, imgClass: string): string {
    if (cromo.imageUrl) {
      return `<img src="${cromo.imageUrl}" alt="${cromo.name}" class="${imgClass}" />`;
    }
    return `<span class="${sizeClass}">${cromo.emoji}</span>`;
  }

  function updateAlbumBtn() {
    if (found.size > 0) {
      albumBtn.style.opacity = '1';
      albumBtn.style.pointerEvents = 'auto';
    }
    albumBadge.textContent = String(found.size);
  }

  function renderAlbum() {
    albumGrid.innerHTML = '';
    albumCount.textContent = `${found.size} de ${CROMOS.length} encontrados`;

    CROMOS.forEach((c) => {
      const isFound = found.has(c.id);
      const div = document.createElement('div');
      div.className = `cromo rounded-2xl p-4 text-center border-2 ${
        isFound
          ? 'bg-white border-gray-200 shadow-md found'
          : 'bg-gray-50 border-dashed border-gray-200'
      }`;

      if (isFound) {
        const visual = cromoVisualHTML(c, 'text-4xl', 'w-16 h-16 object-contain mx-auto');
        const r = RARITY_LABELS[c.rarity];
        const themeHtml = c.theme
          ? `<div class="text-[10px] font-bold uppercase tracking-wide text-verde-600 mb-0.5">${c.theme}</div>`
          : '';
        div.innerHTML = `
          <div class="mb-2 flex items-center justify-center h-16">${visual}</div>
          ${themeHtml}
          <div class="font-bold text-sm text-gray-900">${c.name}</div>
          <div class="text-xs text-gray-400 mt-1">${c.desc}</div>
          <div class="mt-2 text-[10px] font-bold px-2 py-0.5 rounded-full inline-block ${r.bg} ${r.text}">
            ${r.label}
          </div>`;
      } else {
        div.innerHTML = `
          <div class="mb-2 flex items-center justify-center h-16">
            <span class="text-4xl opacity-20">❓</span>
          </div>
          <div class="font-bold text-sm text-gray-300">???</div>
          <div class="text-[11px] text-gray-400 mt-2 italic">${c.hint}</div>`;
      }
      albumGrid.appendChild(div);
    });

    const unfound = CROMOS.filter(c => !found.has(c.id));
    if (unfound.length === 0) {
      albumHint.innerHTML = '';
      const replayBtn = document.createElement('button');
      replayBtn.className = 'text-verde-600 font-bold text-sm hover:underline cursor-pointer';
      replayBtn.textContent = '✨ Ver la celebración otra vez ✨';
      replayBtn.addEventListener('click', () => { closeAlbum(); setTimeout(showGrandFinale, 600); });
      albumHint.appendChild(replayBtn);
    } else {
      albumHint.textContent = `💡 Pista: ${unfound[Math.floor(Math.random() * unfound.length)].hint}`;
    }
  }

  function openAlbum() {
    renderAlbum();
    albumOverlay.style.opacity = '1';
    albumOverlay.style.pointerEvents = 'auto';
    albumCard.style.transform = 'scale(1)';
  }

  function closeAlbum() {
    albumOverlay.style.opacity = '0';
    albumOverlay.style.pointerEvents = 'none';
    albumCard.style.transform = 'scale(0.95)';
  }

  albumBtn.addEventListener('click', openAlbum);
  albumClose.addEventListener('click', closeAlbum);
  albumOverlay.addEventListener('click', (e) => { if (e.target === albumOverlay) closeAlbum(); });

  function unlock(id: string) {
    if (found.has(id)) return;
    found.add(id);
    saveFound(found);
    updateAlbumBtn();

    const cromo = CROMOS.find(c => c.id === id);
    if (cromo) {
      if (id === 'coleccion') {
        showGrandFinale();
      } else {
        showCelebration(cromo);
        spawnAnimation(cromo);
      }
    }

    if (found.size === 9 && !found.has('coleccion')) {
      setTimeout(() => unlock('coleccion'), 3000);
    }
  }

  function closeCelebration() {
    celebration.style.opacity = '0';
    celebration.style.pointerEvents = 'none';
    celebCard.style.transform = 'scale(0.75)';
    celebCard.style.background = '';
    celebCard.style.border = '';
    celebLabel.textContent = '¡Nuevo cromo!';
    celebLabel.style.color = '';
    celebName.style.fontFamily = '';
    celebName.style.color = '';
    celebName.style.fontSize = '';
    celebDesc.style.color = '';
    celebHint.style.color = '';
    particles.innerHTML = '';
    if (celebAnimInterval) {
      clearInterval(celebAnimInterval);
      celebAnimInterval = null;
    }
  }

  function showCelebration(cromo: Cromo) {
    const visual = cromoVisualHTML(cromo, 'text-6xl', 'w-24 h-24 object-contain');
    celebVisual.innerHTML = `<div class="celeb-bounce">${visual}</div>`;
    celebName.textContent = cromo.theme || cromo.name;
    celebDesc.textContent = cromo.theme ? `${cromo.name} — ${cromo.desc}` : cromo.desc;
    const r = RARITY_LABELS[cromo.rarity];
    celebRarity.textContent = r.label;
    celebRarity.className = `mt-3 text-xs font-bold px-3 py-1 rounded-full inline-block ${r.bg} ${r.text}`;

    const t = CARD_THEMES[cromo.id];
    if (t) {
      celebCard.style.background = t.cardBg;
      celebCard.style.border = t.cardBorder;
      celebLabel.textContent = t.labelText;
      celebLabel.style.color = t.labelColor;
      celebName.style.fontFamily = t.font;
      celebName.style.color = t.titleColor;
      celebName.style.fontSize = '1.5rem';
      celebDesc.style.color = t.descColor;
      celebHint.style.color = t.hintColor;
    } else {
      celebCard.style.background = '';
      celebCard.style.border = '';
      celebLabel.textContent = '¡Nuevo cromo!';
      celebLabel.style.color = '';
      celebName.style.fontFamily = '';
      celebName.style.color = '';
      celebName.style.fontSize = '';
      celebDesc.style.color = '';
      celebHint.style.color = '';
    }

    celebration.style.opacity = '1';
    celebration.style.pointerEvents = 'auto';
    celebCard.style.transform = 'scale(1)';

    celebration.addEventListener('click', closeCelebration, { once: true });
  }

  function spawnAnimation(cromo: Cromo) {
    particles.innerHTML = '';
    if (celebAnimInterval) { clearInterval(celebAnimInterval); celebAnimInterval = null; }
    const type = ANIM_TYPES[cromo.id] || 'burst';
    switch (type) {
      case 'rain': spawnRain(cromo); break;
      case 'burst': spawnBurst(cromo); break;
      case 'reveal': spawnReveal(cromo); break;
      case 'fireworks': spawnFireworks(cromo); break;
    }
  }

  function spawnRain(cromo: Cromo) {
    const emojis = [cromo.emoji, '✨', '🌟', '💫', '⭐', '🎊'];
    const colors = [cromo.color, '#4a8f4a', '#9b72b0', '#f59e0b', '#60a5fa'];
    for (let i = 0; i < 50; i++) {
      const el = document.createElement('div');
      el.className = 'rain-particle';
      el.style.left = (Math.random() * 100) + 'vw';
      el.style.setProperty('--dur', (2.5 + Math.random() * 3) + 's');
      el.style.setProperty('--del', (Math.random() * 4) + 's');
      el.style.setProperty('--rot', (360 + Math.random() * 720) + 'deg');
      if (Math.random() > 0.4) {
        el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
        el.style.fontSize = (0.8 + Math.random() * 1.2) + 'rem';
      } else {
        el.style.width = (5 + Math.random() * 7) + 'px';
        el.style.height = (5 + Math.random() * 7) + 'px';
        el.style.background = colors[Math.floor(Math.random() * colors.length)];
        el.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      }
      particles.appendChild(el);
    }
  }

  function spawnBurst(cromo: Cromo) {
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;
    const emojis = [cromo.emoji, '✨', '🌟', '💫', '🎉', '🎊'];
    const colors = [cromo.color, '#4a8f4a', '#9b72b0', '#f59e0b', '#ef4444'];

    function doBurst() {
      for (let i = 0; i < 28; i++) {
        const el = document.createElement('div');
        el.className = 'burst-particle';
        el.style.left = cx + 'px';
        el.style.top = cy + 'px';
        const angle = (Math.PI * 2 * i) / 28 + (Math.random() - 0.5) * 0.3;
        const dist = 100 + Math.random() * 250;
        el.style.setProperty('--px', Math.cos(angle) * dist + 'px');
        el.style.setProperty('--py', Math.sin(angle) * dist + 'px');
        el.style.setProperty('--dur', (1.5 + Math.random() * 1) + 's');
        el.style.setProperty('--end-scale', (0.2 + Math.random() * 0.3).toString());
        el.style.animationDelay = (Math.random() * 0.2) + 's';
        if (Math.random() > 0.35) {
          el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
          el.style.fontSize = (1 + Math.random() * 1) + 'rem';
        } else {
          el.style.width = (6 + Math.random() * 8) + 'px';
          el.style.height = (6 + Math.random() * 8) + 'px';
          el.style.background = colors[Math.floor(Math.random() * colors.length)];
          el.style.borderRadius = '50%';
        }
        particles.appendChild(el);
        setTimeout(() => el.remove(), 3000);
      }
    }

    doBurst();
    celebAnimInterval = setInterval(doBurst, 2500);
  }

  function spawnReveal(cromo: Cromo) {
    const size = Math.min(window.innerWidth, window.innerHeight) * 0.7;
    const cx = window.innerWidth / 2;
    const cy = window.innerHeight / 2;

    const bg = document.createElement('div');
    bg.className = 'reveal-item';
    bg.style.left = (cx - size / 2) + 'px';
    bg.style.top = (cy - size / 2) + 'px';
    bg.style.width = size + 'px';
    bg.style.height = size + 'px';
    bg.style.display = 'flex';
    bg.style.alignItems = 'center';
    bg.style.justifyContent = 'center';
    if (cromo.imageUrl) {
      bg.innerHTML = `<img src="${cromo.imageUrl}" alt="${cromo.name}" style="max-width:100%;max-height:100%;object-fit:contain;opacity:0.2;filter:drop-shadow(0 0 40px ${cromo.color})" />`;
    } else {
      bg.innerHTML = `<span style="font-size:${size * 0.7}px;opacity:0.15;filter:drop-shadow(0 0 40px ${cromo.color})">${cromo.emoji}</span>`;
    }
    particles.appendChild(bg);

    for (let i = 0; i < 3; i++) {
      const ring = document.createElement('div');
      ring.className = 'reveal-shimmer';
      const ringSize = size * 0.4;
      ring.style.left = (cx - ringSize / 2) + 'px';
      ring.style.top = (cy - ringSize / 2) + 'px';
      ring.style.width = ringSize + 'px';
      ring.style.height = ringSize + 'px';
      ring.style.borderColor = cromo.color;
      ring.style.animationDelay = (i * 0.5) + 's';
      particles.appendChild(ring);
    }

    const sparkEmojis = ['✨', '💫', '🌟', '⭐'];
    celebAnimInterval = setInterval(() => {
      for (let i = 0; i < 4; i++) {
        const s = document.createElement('div');
        s.className = 'burst-particle';
        const sx = cx + (Math.random() - 0.5) * size;
        const sy = cy + (Math.random() - 0.5) * size;
        s.style.left = sx + 'px';
        s.style.top = sy + 'px';
        s.textContent = sparkEmojis[Math.floor(Math.random() * sparkEmojis.length)];
        s.style.fontSize = (0.6 + Math.random() * 0.6) + 'rem';
        const angle = Math.random() * Math.PI * 2;
        const dist = 30 + Math.random() * 60;
        s.style.setProperty('--px', Math.cos(angle) * dist + 'px');
        s.style.setProperty('--py', Math.sin(angle) * dist + 'px');
        s.style.setProperty('--dur', (1 + Math.random() * 0.5) + 's');
        particles.appendChild(s);
        setTimeout(() => s.remove(), 2000);
      }
    }, 800);
  }

  function spawnFireworks(cromo: Cromo) {
    const colors = [cromo.color, '#ff4444', '#44aaff', '#ffdd44', '#ff88ff', '#44ff88'];
    const emojis = [cromo.emoji, '✨', '🌟', '💥', '⭐'];

    function fireworkBurst(x: number, y: number) {
      const burstColor = colors[Math.floor(Math.random() * colors.length)];
      const count = 14 + Math.floor(Math.random() * 10);
      for (let i = 0; i < count; i++) {
        const el = document.createElement('div');
        el.className = 'fw-spark';
        el.style.left = x + 'px';
        el.style.top = y + 'px';
        const angle = (Math.PI * 2 * i) / count + (Math.random() - 0.5) * 0.4;
        const dist = 40 + Math.random() * 120;
        el.style.setProperty('--sx', Math.cos(angle) * dist + 'px');
        el.style.setProperty('--sy', Math.sin(angle) * dist + 'px');
        el.style.setProperty('--dur', (0.8 + Math.random() * 0.8) + 's');
        if (Math.random() > 0.5) {
          el.textContent = emojis[Math.floor(Math.random() * emojis.length)];
          el.style.fontSize = (0.6 + Math.random() * 0.8) + 'rem';
        } else {
          el.style.width = (4 + Math.random() * 5) + 'px';
          el.style.height = (4 + Math.random() * 5) + 'px';
          el.style.background = burstColor;
          el.style.borderRadius = '50%';
          el.style.boxShadow = `0 0 6px ${burstColor}`;
        }
        particles.appendChild(el);
        setTimeout(() => el.remove(), 2500);
      }
    }

    const vw = window.innerWidth;
    const vh = window.innerHeight;
    fireworkBurst(vw * 0.3, vh * 0.3);
    setTimeout(() => fireworkBurst(vw * 0.7, vh * 0.4), 300);
    setTimeout(() => fireworkBurst(vw * 0.5, vh * 0.25), 600);

    celebAnimInterval = setInterval(() => {
      fireworkBurst(
        vw * 0.15 + Math.random() * vw * 0.7,
        vh * 0.15 + Math.random() * vh * 0.5
      );
    }, 1200);
  }

  // ============================================================
  //  GRAND FINALE — complete collection celebration
  // ============================================================

  function showGrandFinale() {
    // Stars
    finaleStars.innerHTML = '';
    for (let i = 0; i < 200; i++) {
      const s = document.createElement('div');
      s.className = 'finale-star';
      s.style.left = Math.random() * 100 + '%';
      s.style.top = Math.random() * 100 + '%';
      const sz = Math.random() > 0.92 ? 3 : Math.random() > 0.6 ? 2 : 1;
      s.style.width = sz + 'px';
      s.style.height = sz + 'px';
      s.style.setProperty('--dur', (2 + Math.random() * 4) + 's');
      s.style.setProperty('--del', (Math.random() * 4) + 's');
      finaleStars.appendChild(s);
    }

    // Reset visual state
    finaleQuestion.style.opacity = '0';
    finaleAnswer.style.opacity = '0';
    finaleAnswer.style.transform = 'scale(0.5)';
    finaleSubtitle.style.opacity = '0';
    finaleClose.style.opacity = '0';
    finaleClose.style.pointerEvents = 'none';
    finaleChars.innerHTML = '';
    finaleConfetti.innerHTML = '';

    // Show
    grandFinale.style.opacity = '1';
    grandFinale.style.pointerEvents = 'auto';

    // Music
    let customAudio: HTMLAudioElement | null = null;
    let audioCtx: AudioContext | null = null;
    customAudio = playFinaleMusic();
    if (!customAudio) audioCtx = playMagicMelody();

    // Choreography
    setTimeout(() => { finaleQuestion.style.opacity = '1'; }, 1000);
    setTimeout(() => { finaleQuestion.style.opacity = '0'; }, 4500);
    setTimeout(() => {
      finaleAnswer.style.opacity = '1';
      finaleAnswer.style.transform = 'scale(1)';
      spawnGoldenConfetti();
    }, 5500);
    setTimeout(() => { placeFinaleCharacters(); }, 6500);
    setTimeout(() => { finaleSubtitle.style.opacity = '1'; }, 8000);
    setTimeout(() => {
      finaleClose.style.opacity = '1';
      finaleClose.style.pointerEvents = 'auto';
    }, 10000);

    const close = () => {
      grandFinale.style.opacity = '0';
      grandFinale.style.pointerEvents = 'none';
      if (customAudio) { customAudio.pause(); customAudio.currentTime = 0; }
      if (audioCtx) { try { audioCtx.close(); } catch {} }
      finaleClose.removeEventListener('click', close);
    };
    finaleClose.addEventListener('click', close);
  }

  function placeFinaleCharacters() {
    finaleChars.innerHTML = '';
    const vw = window.innerWidth;
    const vh = window.innerHeight;
    const radius = Math.min(vw, vh) * 0.32;
    const cx = vw / 2;
    const cy = vh / 2;

    CROMOS.forEach((cromo, i) => {
      const angle = (Math.PI * 2 * i) / CROMOS.length - Math.PI / 2;
      const x = cx + Math.cos(angle) * radius;
      const y = cy + Math.sin(angle) * radius;

      const el = document.createElement('div');
      el.className = 'finale-char';
      el.style.left = x + 'px';
      el.style.top = y + 'px';
      el.style.setProperty('--dur', (3 + Math.random() * 2) + 's');
      el.style.setProperty('--del', (i * 0.15) + 's');
      el.style.opacity = '0';
      el.style.transition = 'opacity 0.6s ease';

      if (cromo.imageUrl) {
        el.innerHTML = `<img src="${cromo.imageUrl}" alt="${cromo.name}"
          class="w-10 h-10 md:w-14 md:h-14 object-contain" />`;
      } else {
        el.innerHTML = `<span class="text-2xl md:text-4xl">${cromo.emoji}</span>`;
      }

      finaleChars.appendChild(el);
      setTimeout(() => { el.style.opacity = '1'; }, i * 180);
    });
  }

  function spawnGoldenConfetti() {
    const golds = ['#ffd700', '#ffaa00', '#ff8c00', '#fff4cc', '#ffe066', '#ffffff', '#fbbf24'];
    for (let i = 0; i < 100; i++) {
      const c = document.createElement('div');
      c.className = 'finale-confetti';
      c.style.left = Math.random() * 100 + '%';
      c.style.width = (4 + Math.random() * 8) + 'px';
      c.style.height = (4 + Math.random() * 8) + 'px';
      c.style.background = golds[Math.floor(Math.random() * golds.length)];
      c.style.borderRadius = Math.random() > 0.5 ? '50%' : '2px';
      c.style.setProperty('--dur', (3 + Math.random() * 5) + 's');
      c.style.setProperty('--del', (Math.random() * 4) + 's');
      finaleConfetti.appendChild(c);
      setTimeout(() => c.remove(), 12000);
    }
  }

  function playFinaleMusic(): HTMLAudioElement | null {
    if (!MUSIC_URL) return null;
    try {
      const a = new Audio(MUSIC_URL);
      a.volume = 0.5;
      a.play().catch(() => {});
      return a;
    } catch { return null; }
  }

  function playMagicMelody(): AudioContext | null {
    try {
      const ctx = new AudioContext();
      const master = ctx.createGain();
      master.gain.value = 0.1;
      master.connect(ctx.destination);

      const notes = [
        { f: 523.25, t: 0 },     // C5
        { f: 659.25, t: 0.28 },  // E5
        { f: 783.99, t: 0.56 },  // G5
        { f: 1046.50, t: 0.84 }, // C6
        { f: 880.00, t: 1.4 },   // A5
        { f: 1046.50, t: 1.6 },  // C6
        { f: 1318.51, t: 1.8 },  // E6
        { f: 1567.98, t: 2.1 },  // G6
        // Chord
        { f: 1046.50, t: 3.0 },  // C6
        { f: 1318.51, t: 3.0 },  // E6
        { f: 1567.98, t: 3.0 },  // G6
        // Sparkle
        { f: 2093.00, t: 3.8 },  // C7
        { f: 1567.98, t: 4.3 },  // G6
        { f: 2093.00, t: 4.8 },  // C7
      ];

      notes.forEach(({ f, t }) => {
        const o = ctx.createOscillator();
        const g = ctx.createGain();
        o.type = 'sine';
        o.frequency.value = f;

        const o2 = ctx.createOscillator();
        const g2 = ctx.createGain();
        o2.type = 'sine';
        o2.frequency.value = f * 2.005;

        g.gain.setValueAtTime(0, ctx.currentTime + t);
        g.gain.linearRampToValueAtTime(1, ctx.currentTime + t + 0.015);
        g.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + t + 2.5);

        g2.gain.setValueAtTime(0, ctx.currentTime + t);
        g2.gain.linearRampToValueAtTime(0.25, ctx.currentTime + t + 0.015);
        g2.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + t + 1.8);

        o.connect(g); g.connect(master);
        o2.connect(g2); g2.connect(master);

        o.start(ctx.currentTime + t);
        o.stop(ctx.currentTime + t + 3);
        o2.start(ctx.currentTime + t);
        o2.stop(ctx.currentTime + t + 2.5);
      });

      return ctx;
    } catch { return null; }
  }

  // === SECRET 1: Logo x7 ===
  let logoTaps = 0;
  let logoTimer: ReturnType<typeof setTimeout>;
  function initLogoSecret() {
    document.querySelectorAll('a[href="/"]').forEach(el => {
      el.addEventListener('click', (e) => {
        logoTaps++;
        clearTimeout(logoTimer);
        logoTimer = setTimeout(() => { logoTaps = 0; }, 2500);
        if (logoTaps >= 7) {
          e.preventDefault();
          logoTaps = 0;
          unlock('logo7');
        }
      });
    });
  }

  // === SECRET 2: Ladybug ===
  const ladybug = document.getElementById('secret-ladybug');
  let ladybugClicks = 0;
  ladybug?.addEventListener('click', () => {
    ladybugClicks++;
    if (ladybugClicks >= 3) { ladybugClicks = 0; unlock('ladybug'); }
  });

  // === SECRET 3: Type "lirios" ===
  let typedBuf = '';
  document.addEventListener('keypress', (e) => {
    typedBuf += e.key.toLowerCase();
    if (typedBuf.length > 30) typedBuf = typedBuf.slice(-30);
    if (typedBuf.includes('lirios')) { typedBuf = ''; unlock('lirios'); }
  });

  // === SECRET 4: Konami Code ===
  const KONAMI = ['ArrowUp','ArrowUp','ArrowDown','ArrowDown','ArrowLeft','ArrowRight','ArrowLeft','ArrowRight','b','a'];
  let konamiPos = 0;
  document.addEventListener('keydown', (e) => {
    if (e.key === KONAMI[konamiPos]) {
      konamiPos++;
      if (konamiPos === KONAMI.length) { konamiPos = 0; unlock('konami'); }
    } else {
      konamiPos = e.key === KONAMI[0] ? 1 : 0;
    }
  });

  // === SECRET 5: Double-click "comunidad" ===
  document.addEventListener('dblclick', () => {
    const sel = window.getSelection()?.toString().trim().toLowerCase();
    if (sel === 'comunidad') unlock('comunidad');
  });

  // === SECRET 6: Night visit ===
  const hour = new Date().getHours();
  if (hour >= 22 || hour < 6) unlock('nocturno');

  // === SECRET 7: Scroll bottom /privacidad ===
  function initPrivacidadSecret() {
    if (!window.location.pathname.startsWith('/privacidad')) return;
    const handler = () => {
      if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) {
        unlock('privacidad');
        window.removeEventListener('scroll', handler);
      }
    };
    window.addEventListener('scroll', handler, { passive: true });
  }

  // === SECRET 8: Hidden star /fiestas ===
  function initFiestasSecret() {
    const star = document.getElementById('secret-star');
    if (!star) return;
    if (window.location.pathname.startsWith('/fiestas')) {
      star.classList.remove('hidden');
      star.classList.add('hint-pulse');
      star.addEventListener('click', () => { unlock('estrella'); star.classList.add('hidden'); });
    }
  }

  // === SECRET 9: Tap 📸 on /galeria 3x ===
  let cameraClicks = 0;
  let cameraTimer: ReturnType<typeof setTimeout>;
  function initGaleriaSecret() {
    if (!window.location.pathname.startsWith('/galeria')) return;
    document.querySelectorAll('*').forEach(el => {
      if (el.textContent?.trim() === '📸' && el.children.length === 0) {
        el.addEventListener('click', () => {
          cameraClicks++;
          clearTimeout(cameraTimer);
          cameraTimer = setTimeout(() => { cameraClicks = 0; }, 2000);
          if (cameraClicks >= 3) { cameraClicks = 0; unlock('camara'); }
        });
      }
    });
  }

  // === INIT ===
  function initEggs() {
    CROMOS = loadCromos();
    MUSIC_URL = loadMusicUrl();
    found = getFound();
    updateAlbumBtn();
    initLogoSecret();
    initPrivacidadSecret();
    initFiestasSecret();
    initGaleriaSecret();
  }

  initEggs();
  document.addEventListener('astro:after-swap', initEggs);
</script>
