---
interface Photo {
  id: string;
  ruta_storage: string;
  pie?: string | null;
}

interface Props {
  fotos: Photo[];
  bucketUrl: string;
}

const { fotos, bucketUrl } = Astro.props;
---

{fotos.length > 0 ? (
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3 stagger-children">
    {fotos.map((foto) => (
      <button
        type="button"
        class="lightbox-trigger block aspect-square overflow-hidden rounded-xl bg-gray-100
               hover:shadow-xl transition-all duration-500 focus:outline-none focus:ring-2 focus:ring-verde-400
               group relative cursor-pointer"
        data-src={`${bucketUrl}/${foto.ruta_storage}`}
        data-alt={foto.pie || 'Foto del álbum'}
      >
        <img
          src={`${bucketUrl}/${foto.ruta_storage}`}
          alt={foto.pie || 'Foto del álbum'}
          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors duration-300 flex items-center justify-center">
          <svg class="w-8 h-8 text-white opacity-0 group-hover:opacity-100 transition-all duration-300 transform scale-50 group-hover:scale-100" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/>
          </svg>
        </div>
        {foto.pie && (
          <div class="absolute bottom-0 left-0 right-0 bg-gradient-to-t from-black/60 to-transparent p-3 pt-6
                      opacity-0 group-hover:opacity-100 transition-opacity duration-300">
            <p class="text-white text-xs">{foto.pie}</p>
          </div>
        )}
      </button>
    ))}
  </div>
) : (
  <p class="text-gray-500 text-center py-8">Este álbum aún no tiene fotos.</p>
)}
