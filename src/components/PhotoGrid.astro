---
interface Photo {
  id: string;
  ruta_storage: string;
  pie?: string | null;
}

interface Props {
  fotos: Photo[];
  bucketUrl: string;
}

const { fotos, bucketUrl } = Astro.props;
---

{fotos.length > 0 ? (
  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3">
    {fotos.map((foto) => (
      <a
        href={`${bucketUrl}/${foto.ruta_storage}`}
        target="_blank"
        class="block aspect-square overflow-hidden rounded-lg bg-gray-100 hover:opacity-90 transition-opacity focus:outline-none focus:ring-2 focus:ring-verde-400"
      >
        <img
          src={`${bucketUrl}/${foto.ruta_storage}`}
          alt={foto.pie || 'Foto del álbum'}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </a>
    ))}
  </div>
) : (
  <p class="text-gray-500 text-center py-8">Este álbum aún no tiene fotos.</p>
)}
