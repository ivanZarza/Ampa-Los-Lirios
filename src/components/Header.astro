---
const currentPath = Astro.url.pathname;
const links = [
  { href: '/', label: 'Inicio' },
  { href: '/fiestas', label: 'Fiestas' },
  { href: '/galeria', label: 'Galería' },
  { href: '/colaboradores', label: 'Colaboradores' },
  { href: '/contacto', label: 'Contacto' },
];
---

<header class="bg-white shadow-sm sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4">
    <div class="flex items-center justify-between h-16">
      <a href="/" class="flex items-center gap-2 text-verde-600 font-bold text-xl">
        <span>🌿</span>
        <span>AMPA Los Lirios</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Navegación principal">
        {links.map(({ href, label }) => (
          <a
            href={href}
            class:list={[
              'px-3 py-2 rounded-lg text-sm font-medium transition-colors',
              currentPath === href || (href !== '/' && currentPath.startsWith(href))
                ? 'bg-verde-50 text-verde-700'
                : 'text-gray-600 hover:bg-gray-50 hover:text-gray-900',
            ]}
          >
            {label}
          </a>
        ))}
      </nav>

      <!-- Mobile menu button -->
      <button
        id="menu-toggle"
        class="md:hidden p-2 rounded-lg text-gray-600 hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-verde-400"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path id="menu-icon" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>

    <!-- Mobile nav -->
    <nav id="mobile-menu" class="hidden md:hidden pb-4" aria-label="Navegación móvil">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[
            'block px-3 py-3 rounded-lg text-base font-medium transition-colors',
            currentPath === href || (href !== '/' && currentPath.startsWith(href))
              ? 'bg-verde-50 text-verde-700'
              : 'text-gray-600 hover:bg-gray-50',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = menu?.classList.toggle('hidden') === false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
