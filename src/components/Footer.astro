---
const year = new Date().getFullYear();
---

<footer class="bg-gray-800 text-gray-300 mt-auto">
  <div class="max-w-6xl mx-auto px-4 py-8">
    <div class="flex flex-col md:flex-row items-center justify-between gap-4 text-sm">
      <div class="flex items-center gap-2">
        <span>🌿</span>
        <span class="font-semibold text-white">AMPA Los Lirios</span>
      </div>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/contacto" class="hover:text-white transition-colors">Contacto</a>
        <a href="/privacidad" class="hover:text-white transition-colors">Privacidad y aviso legal</a>
      </div>
      <p>&copy; {year} AMPA Los Lirios</p>
    </div>
  </div>
</footer>
