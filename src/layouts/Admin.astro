---
import '../styles/global.css';
import { getSession, isAdmin, getRoutesForUser, canAccessRoute } from '../lib/auth';

interface Props {
  title: string;
  skipAuthCheck?: boolean;
}

const { title, skipAuthCheck } = Astro.props;

let rutasUsuario: any[] = [];
let userEmail = '';
const currentPath = Astro.url.pathname;

if (!skipAuthCheck) {
  const session = await getSession(Astro.cookies);
  if (session?.user?.email) {
    userEmail = session.user.email;
    const admin = await isAdmin(userEmail);
    if (admin) {
      rutasUsuario = await getRoutesForUser(userEmail);
      // Comprobar acceso a la ruta actual (excepto /admin y /admin/login)
      if (currentPath !== '/admin' && currentPath !== '/admin/' && currentPath !== '/admin/login') {
        const tieneAcceso = await canAccessRoute(userEmail, currentPath);
        if (!tieneAcceso) {
          return Astro.redirect('/admin?sin_permiso=1');
        }
      }
    }
  }
}
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} — Admin AMPA</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <nav class="bg-verde-600 text-white shadow-md">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/admin" class="text-lg font-bold hover:text-verde-100 transition-colors">
          Panel AMPA
        </a>
        <div class="flex items-center gap-4 text-sm">
          <a href="/" class="hover:text-verde-100 transition-colors" target="_blank">Ver web</a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="hover:text-verde-100 transition-colors cursor-pointer">
              Salir
            </button>
          </form>
        </div>
      </div>
    </nav>

    {rutasUsuario.length > 0 && (
      <nav class="bg-white border-b border-gray-200 shadow-sm overflow-x-auto">
        <div class="max-w-5xl mx-auto px-4 flex items-center gap-1 text-sm" id="admin-nav">
          {rutasUsuario.map(r => {
            const isActive = currentPath === r.ruta || currentPath.startsWith(r.ruta + '/');
            return (
              <a
                href={r.ruta}
                class={`px-3 py-2.5 rounded-t whitespace-nowrap transition-colors ${
                  isActive
                    ? 'bg-verde-50 text-verde-700 font-semibold border-b-2 border-verde-600'
                    : 'text-gray-500 hover:bg-verde-50 hover:text-verde-700'
                }`}
              >
                {r.nombre}
              </a>
            );
          })}
        </div>
      </nav>
    )}

    <div class="max-w-5xl mx-auto px-4 py-6">
      <slot />
    </div>
  </body>
</html>
