---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title} — Admin AMPA</title>
  </head>
  <body class="min-h-screen bg-gray-50">
    <nav class="bg-verde-600 text-white shadow-md">
      <div class="max-w-5xl mx-auto px-4 py-3 flex items-center justify-between">
        <a href="/admin" class="text-lg font-bold hover:text-verde-100 transition-colors">
          Panel AMPA
        </a>
        <div class="flex items-center gap-4 text-sm">
          <a href="/" class="hover:text-verde-100 transition-colors" target="_blank">Ver web</a>
          <form method="POST" action="/api/auth/logout">
            <button type="submit" class="hover:text-verde-100 transition-colors cursor-pointer">
              Salir
            </button>
          </form>
        </div>
      </div>
    </nav>

    <div class="max-w-5xl mx-auto px-4 py-6">
      <slot />
    </div>
  </body>
</html>
